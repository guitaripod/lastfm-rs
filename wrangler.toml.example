# wrangler.toml.example — template for self-hosting the lastfm-rs worker.
#
# Do not put your real IDs here. Run ./scripts/setup-worker.sh, which copies this
# file to wrangler.toml (gitignored) and fills in the KV namespace IDs it creates.
# Then add your secrets and deploy:
#   wrangler secret put LASTFM_API_KEY
#   wrangler secret put LASTFM_API_SECRET
#   wrangler deploy

name = "lastfm-proxy-worker"
main = "build/worker/shim.mjs"
compatibility_date = "2024-01-01"

[build]
command = "bash scripts/build-worker.sh"

[vars]
ENVIRONMENT = "production"
LASTFM_API_BASE_URL = "http://ws.audioscrobbler.com/2.0/"

[[kv_namespaces]]
binding = "CACHE"
id = "__CACHE_ID__"
preview_id = "__CACHE_PREVIEW_ID__"

[[kv_namespaces]]
binding = "RATE_LIMIT"
id = "__RATE_LIMIT_ID__"
preview_id = "__RATE_LIMIT_PREVIEW_ID__"

[env.preview]
vars = { ENVIRONMENT = "preview" }

[env.staging]
vars = { ENVIRONMENT = "staging" }

[observability]
enabled = true
