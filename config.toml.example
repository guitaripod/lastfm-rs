# Last.fm CLI Configuration Template
# Copy this file to ~/.config/lastfm-cli/config.toml and update with your settings.

# Worker URL - REQUIRED. The Last.fm proxy worker you deployed yourself.
# The CLI ships with no default backend; it will not talk to anyone else's worker.
# Deploy your own (see https://github.com/guitaripod/lastfm-rs#self-hosting), then
# set it here, or override per-invocation with the LASTFM_WORKER_URL env var or the
# --worker-url flag.
worker_url = ""

# Default output format: json, table, pretty, compact
output_format = "pretty"

# Cache TTL in seconds (how long to cache API responses)
cache_ttl = 3600

# Interactive mode history size
interactive_history_size = 1000

# Enable colored output
color_output = true

# Request timeout in seconds
request_timeout_secs = 30
